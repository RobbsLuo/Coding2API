# 环境变量模板：复制为 .env 后按需修改。
#
#   cp .env.example .env
#
# 只有 APP_SECRET 必填（其余留空即用括号内的默认值）。完整清单与逐项说明见
# README「配置」一节（权威默认值在 src/config.py，且每一项都已透传到
# docker-compose.yml）。
#
# .env 不入库（见 .gitignore）；切勿把真实 APP_SECRET 提交进仓库。

# 凭证列加密密钥。**用 ≥32 字符的随机串**（派生是无盐单次 SHA-256，人类可记的
# 口令在库外流后可被离线爆破）。丢失 = 已存凭证全部不可解，只能重录。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# **低于 16 字符、低熵、占位值/示例值都会被拒绝启动**（KNOWN_WEAK_SECRETS）；
# 真要轮换见 scripts/rotate_app_secret.py（先备份、停机、再重加密，否则凭证全丢）。
APP_SECRET=

# 管理台管理员用户名（逗号分隔）。仅引导期生效：DB 里已有角色后不再覆盖。
ADMIN_USERNAMES=admin

# 浏览器可达地址。远程部署必须设成真实可达地址，TRAE 登录回调依赖它。
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 监听地址与端口（PORT 同时决定 compose 的宿主机映射端口与容器内监听端口）。
HOST=127.0.0.1
PORT=8000

# 时区。容器默认 Asia/Shanghai；改这里会透传进容器（务必保持与宿主一致，
# 签到 / 额度周期按「今天 9 点」判断）。
TZ=Asia/Shanghai

# SQLite 与运行数据目录。
DATA_DIR=./data

# 仅引导期：老式用户文件路径，启动时一次性导入 SQLite（幂等）。
USERS_FILE=secrets/users.txt

# 请求未指定模型（或为 auto/空）时使用的默认模型。
DEFAULT_MODEL=deepseek-v4.1-flash

# TRAE 本账号拥有的访问身份（逗号分隔）：`0`=免费档，`1/2/3/5/100`=各档付费会员 /
# 团队 / 内部身份。上游按身份授权模型，白名单不含本账号身份的模型选中必回 1005，
# 因此拉取时直接过滤。留空 = 不按身份过滤（上游给什么就展示什么）。
# 开通会员后改成 `0,1,2,3,5` 即可放出会员模型。
TRAE_ACCOUNT_IDENTITIES=0

# Host 白名单（逗号分隔，防 DNS rebinding）；留空 = 放行本地回环与 PUBLIC_BASE_URL 主机。
ALLOWED_HOSTS=

# 是否暴露 /docs 与 /openapi.json；默认关闭（匿名可拉全量端点清单 = 送侦察图）。
ENABLE_DOCS=false

# 是否采信 X-Forwarded-For（仅当本服务前面恰好一层受信反代时开启）。
TRUST_PROXY=false
# 受信反代的对端地址（逗号分隔 IP/CIDR）。留空 = 采信任意对端（旧行为）。
# 只要端口对外可达（不只反代可达）就必须配，否则任何人都能自带
# X-Forwarded-For 冒充白名单 IP，绕过 API Key 的 allowed_ips。
TRUSTED_PROXIES=
# 是否把「TRUST_PROXY=true 但 TRUSTED_PROXIES 为空/写坏」当成启动失败。
# 默认 false = 保持旧行为（仅 doctor 给 WARN），升级不打断存量部署；
# 确认本部署前面只有受信反代、名单不该留空时置 true，可防误删 / 漏配。
REQUIRE_TRUSTED_PROXIES=false

# ---- 公网部署（Docker + Caddy，见 README「公网部署（Docker）」）----
# 有公网 IP 的 VPS：填域名即自动申请 / 续期证书；本地与内网部署保持留空
# （留空时 base compose 不引用这三项，不影响常规启动）。
# 也可以填**公网 IP**（没有域名时）：此时必须配 TLS_MODE=internal 走自签。
PUBLIC_DOMAIN=
# 域名模式（TLS_MODE 留空 / acme）必填：Let's Encrypt 到期通知收件人，也是
# ACME 账号标识；自签模式（internal）用不到，留空即可。
ACME_EMAIL=
# TLS 模式：留空 / acme = 自动申请证书（站点须是域名）；internal = Caddy 自带
# CA 自签（站点是公网 IP，证书浏览器不认、需装根证书或客户端跳过校验）。
TLS_MODE=

# 通用 OpenAI 兼容上游（可选，非逆向）：留空 = 不启用该渠道。
# 接 Command Code / Kimi Code / MiniMax / 智谱免费档 / 自建 vLLM / LiteLLM 等。
# 凭证在管理台按 `{"api_key": "sk-…"}` 导入（进加密池，可多把轮换）。
GENERIC_API_ENDPOINT=
# 端点白名单（逗号分隔）；留空 = 放行任意 http(s)。拒绝非 HTTP scheme。
GENERIC_ALLOWED_ENDPOINTS=
# 上游没有 /models 时的静态模型表（逗号分隔）。
GENERIC_MODELS=
# 聊天最小间隔（秒），0 = 不节流；只用于压低自建网关 / 官方 API 的 RPM。
GENERIC_CHAT_MIN_INTERVAL=0
# 覆盖 User-Agent（留空 = 不发自定义 UA）。
GENERIC_USER_AGENT=

# 按渠道出站代理，格式 `渠道=代理URL;渠道2=代理URL2`；留空 = 全部直连。
# 渠道取十一个渠道名（含 generic），协议支持 http/https/socks5/socks5h。环境变量 HTTP_PROXY 等一律不采信。
# ⚠️ 容器里 127.0.0.1 指容器自身，不是宿主：代理跑在宿主时须写
# host.docker.internal（compose 已加 extra_hosts），如 codebuddy=http://host.docker.internal:7897。
PROVIDER_PROXIES=

# 运维告警出口（留空 = 只留站内记录，不外推）。
# 通用 Webhook 发完整 JSON + HMAC 签名；飞书/Slack 各按自己的消息格式发送。
ALERT_WEBHOOK_URL=
ALERT_FEISHU_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=

# 日志落库行数（`log_events` 环形表）：重启后仍可回看，也支持按 request_id 回溯。
# 0 = 不落库（只保留内存环）。可热更。
LOG_PERSIST_LINES=2000

# /metrics 的 Bearer 令牌。留空 = 只放行回环对端（本机 127.0.0.1 / ::1 抓取，
# 公网与内网其它主机一律 401）。要对远端抓取开放就设一个随机串。
METRICS_TOKEN=

# 上游尝试链响应头（X-Upstream-Attempts / X-Upstream-Degraded）。
# 默认关闭：这些头泄露账号池规模、成本与路由指纹。可热更。
EXPOSE_UPSTREAM_HEADERS=false

# 内容拒绝（CodeBuddy 11128 等）冻结阈值：同一发起者对同一渠道累计命中多少
# 次后前置 403 provider_access_frozen。0 = 只记录不冻结（默认）。可热更。
ACCESS_FREEZE_THRESHOLD=0

# OTLP/HTTP JSON 指标出口（POST {endpoint}/v1/metrics）。留空 = 关闭（零出站）。
# 只导 gen_ai.* 指标（模型/供应商/token/延迟/错误类型），绝不导出提示词、回答
# 或 system instructions。非回环主机强制 https。
OTLP_ENDPOINT=
OTLP_EXPORT_SECONDS=60
OTLP_HEADERS=
