# 环境变量模板：复制为 .env 后按需修改。
#
#   cp .env.example .env
#
# 只有 APP_SECRET 必填（其余留空即用括号内的默认值）。完整清单与逐项说明见
# README「配置」一节（权威默认值在 src/config.py，且每一项都已透传到
# docker-compose.yml）。
#
# .env 不入库（见 .gitignore）；切勿把真实 APP_SECRET 提交进仓库。

# 凭证列加密密钥，≥16 字符。丢失 = 已存凭证全部不可解，只能重录（无密钥轮换）。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET=

# 管理台管理员用户名（逗号分隔）。仅引导期生效：DB 里已有角色后不再覆盖。
ADMIN_USERNAMES=admin

# 浏览器可达地址。远程部署必须设成真实可达地址，TRAE 登录回调依赖它。
PUBLIC_BASE_URL=http://127.0.0.1:8000

# 监听地址与端口（PORT 同时决定 compose 的宿主机映射端口与容器内监听端口）。
HOST=127.0.0.1
PORT=8000

# 时区。容器默认 Asia/Shanghai；改这里会透传进容器（务必保持与宿主一致，
# 签到 / 额度周期按「今天 9 点」判断）。
TZ=Asia/Shanghai

# SQLite 与运行数据目录。
DATA_DIR=./data

# 仅引导期：老式用户文件路径，启动时一次性导入 SQLite（幂等）。
USERS_FILE=secrets/users.txt

# 请求未指定模型（或为 auto/空）时使用的默认模型。
DEFAULT_MODEL=glm-5.2

# Host 白名单（逗号分隔，防 DNS rebinding）；留空 = 放行本地回环与 PUBLIC_BASE_URL 主机。
ALLOWED_HOSTS=

# 是否暴露 /docs 与 /openapi.json；默认关闭（匿名可拉全量端点清单 = 送侦察图）。
ENABLE_DOCS=false

# 是否采信 X-Forwarded-For（仅当本服务前面恰好一层受信反代时开启）。
TRUST_PROXY=false

# 按渠道出站代理，格式 `渠道=代理URL;渠道2=代理URL2`；留空 = 全部直连。
# 渠道取八个渠道名，协议支持 http/https/socks5/socks5h。环境变量 HTTP_PROXY 等一律不采信。
# ⚠️ 容器里 127.0.0.1 指容器自身，不是宿主：代理跑在宿主时须写
# host.docker.internal（compose 已加 extra_hosts），如 codebuddy=http://host.docker.internal:7897。
PROVIDER_PROXIES=
