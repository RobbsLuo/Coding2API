    "views": [
      {
        "id": "onboarding",
        "label": "开通",
        "focus": [
          "a_create",
          "s_create",
          "d_user",
          "u_activate",
          "s_activate"
        ],
        "note": "建号只产生一次性令牌摘要；用户自设密码后令牌立即作废。"
      },
      {
        "id": "session",
        "label": "登录与会话",
        "focus": [
          "u_login",
          "s_login",
          "d_audit",
          "s_session",
          "s_guard"
        ],
        "note": "会话 Cookie 带 epoch；角色不入 Cookie，每次请求从库里现读。"
      },
      {
        "id": "revoke",
        "label": "变更与吊销",
        "focus": [
          "a_change",
          "d_epoch",
          "s_guard",
          "u_selfpwd"
        ],
        "note": "改角色、禁用、重置密码都让 epoch +1，旧 Cookie 下一次请求即 401。"
      }
    ]
  },
