  "cards": [
    {
      "dot": "violet",
      "title": "角色边界",
      "items": [
        "admin：用户管理、任务与配置、审计、日志、告警、备份、上游 OAuth 登录",
        "operator：凭证读写、全站统计、账单、上游状态、模型列表与探活",
        "viewer：只读；统计强制收敛到本人，凭证昵称不下发"
      ]
    },
    {
      "dot": "rose",
      "title": "防锁死与撤销",
      "items": [
        "不能停用或降级最后一个活跃管理员，也不能对自己降级 / 停用",
        "改角色、改密、禁用都会 bump epoch —— 代价是重新登录，这是有意的",
        "ADMIN_USERNAMES 与 users.txt 只在「库里还没有活跃 admin」的引导期生效"
      ]
    },
    {
      "dot": "emerald",
      "title": "为什么不用共享初始密码",
      "items": [
        "建号时写随机占位密码，管理员也不知道，用户只能用令牌自设",
        "令牌只存 SHA-256 摘要，明文仅在创建响应里出现一次，24 小时过期",
        "登录同样校验 Origin，防 login CSRF"
      ]
    }
  ]
}
