  "cards": [
    {
      "dot": "cyan",
      "title": "对外契约",
      "items": [
        "/v1/chat/completions、/v1/responses、/v1/messages",
        "/v1/models 按渠道凭证加载 + 黑名单",
        "/v1/user/balance、/healthz 池健康"
      ]
    },
    {
      "dot": "emerald",
      "title": "调度与弹性",
      "items": [
        "选号：pin → 粘性 → 到期积分 → 三态健康度",
        "模型级冷却隔离到单个模型；跨渠道 fallback 兼容组（未出帧前回退）",
        "六渠道同池调度；8 类后台任务汇总「任务与配置」"
      ]
    },
    {
      "dot": "violet",
      "title": "网络与告警",
      "items": [
        "按渠道出站代理 PROVIDER_PROXIES（HTTP/SOCKS5，可选，启动期）",
        "运维告警四类风险 → alert_events + 可选 webhook",
        "环境代理不采信（trust_env=False），只认显式配置"
      ]
    },
    {
      "dot": "rose",
      "title": "数据与安全",
      "items": [
