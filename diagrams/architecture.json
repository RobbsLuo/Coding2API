  "cards": [
    {
      "dot": "cyan",
      "title": "对外契约",
      "items": [
        "OpenAI 兼容：/v1/chat/completions + /v1/models",
        "扁平模型名 + model@provider 后缀强制指定上游",
        "非流式请求由服务端聚合 SSE 后返回"
      ]
    },
    {
      "dot": "emerald",
      "title": "调度与弹性",
      "items": [
        "三态健康度：known / unknown / exhausted",
        "三级冷却：权益耗尽 12h、限流 60s、连续错误 10m",
        "单请求最多轮换 3 个凭证，流内错误注入 SSE"
      ]
    },
    {
      "dot": "rose",
      "title": "数据与安全",
      "items": [
        "SQLite WAL：凭证加密列、API Key 摘要、脱敏统计",
        "统计不存提示词 / Token，明细保留 90 天"
      ]
    }
  ]
