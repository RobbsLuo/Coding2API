  "cards": [
    {
      "dot": "cyan",
      "title": "选号顺序",
      "items": [
        "pin 优先 → 会话粘性 → 到期额度（主 36h / 次 7d 字典序）→ 三态健康度",
        "健康度 known DESC > unknown > exhausted(-1)，同分按 credential_id 稳定",
        "状态全部落 credentials 表，进程重启不丢冷却"
      ]
    },
    {
      "dot": "rose",
      "title": "账号级冷却（整凭证）",
      "items": [
        "PLAN 12h / OTHER×3 10m / SOFT 60s 写 cooling_until，换号即整个凭证不可选",
        "CREDIT（余额不足）冷却到次日 04:00，等当天签到恢复",
        "冷却出现时清空该凭证的模型级条目，防止豁免泄漏"
      ]
    },
    {
      "dot": "amber",
      "title": "模型级冷却（只锁该模型）",
      "items": [
        "MODEL 10m 起翻倍封顶 2h；BLOCKED 6h 起翻倍封顶 24h；CONCURRENCY 固定 60s 不翻倍",
        "登记名用该凭证所属上游的原始模型名，同账号其他模型不受影响",
        "无模型名可归因时退化为账号级 SOFT，不写孤儿记录"
      ]
    }
  ]
