  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "Bearer sk- 经 api_key_user 摘要查表，IP 白名单在鉴权当场判掉",
        "model_resolver 解析候选集：扁平名全渠扇出，@provider 锁定单渠",
        "选号顺序：pin 优先 → 会话粘性 → 到期额度 → 三态健康度"
      ]
    },
    {
      "dot": "rose",
      "title": "失败轮换",
      "items": [
        "上游 ≥400 经 classify 归类后 note_error，冷却状态落 SQLite",
        "INVALID（模型不存在）不冷却凭证，跳过该上游全部凭证，全拒返回 400",
        "REQUEST 类换号不落库：既不冷却也不累计，避免误伤健康凭证"
      ]
    },
    {
      "dot": "emerald",
      "title": "流式与记账",
      "items": [
        "Event → OpenAI chunk（流式）或聚合（非流式），首块补 role:assistant",
        "stats.collector 写 usage_events：tokens / latency / ttfb / ok",
        "note_success 清 err_count，并把本对话重新粘到实际服务的凭证"
      ]
    }
  ]
