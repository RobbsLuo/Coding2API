verify-deps-before-run=false
# 不自动安装 peer 依赖。
# 起因：@lobehub/icons 把 @lobehub/ui / antd 声明为 peer，自动安装会拖进 400+ 个
# 包（antd 全家桶、emotion、rc-*），而我们只 import 它的静态图标组件
# （es/<Name>/components/{Color,Mono}），那些文件不引用 @lobehub/ui。
# 关掉后 lock 里的包从 1023 降到 601 个，也避免 peer 版本对不上（icons 6.x 要
# ui ^6，自动装的却是 5.42.6）。
# 代价：真正需要的 peer 必须显式声明——@testing-library/dom 已加进 devDependencies。
# pnpm 每次安装会列出「Peer dependencies that should be installed」，缺了看得见。
auto-install-peers=false
