# systemd unit 模板（Linux 生产部署）
#
# 安装：
#     sudo useradd --system --home /opt/coding2api coding2api
#     sudo cp deploy/systemd/coding2api.service /etc/systemd/system/
#     sudo systemctl daemon-reload && sudo systemctl enable --now coding2api
#     journalctl -u coding2api -f        # 看日志
#
# 日志：走 journald（StandardOutput=journal），journald 自带容量轮转，
# 无需 logrotate。全局限额在 /etc/systemd/journald.conf：
#     SystemMaxUse=500M
#     SystemMaxFileSize=50M
# 也可按 unit 限制：
#     sudo systemctl edit coding2api
#     [Service]
#     LogRateLimitIntervalSec=30s
#     LogRateLimitBurst=1000
#
# 注意：应用只写 stdout/stderr，不自己写文件、不自己轮转
# （见 src/webapp/logging.py 的原因说明）。

[Unit]
Description=Coding2API — CodeBuddy / TRAE SOLO 统一 OpenAI 兼容出口
After=network-online.target
Wants=network-online.target
# 重启风暴封顶：配合下方 Restart=always。5 分钟内超过 5 次拉起就进入 failed
# 状态停下，避免「另一实例持锁」这类可预期的 0 退出变成无限重拉。
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=coding2api
Group=coding2api
WorkingDirectory=/opt/coding2api

# 必填：凭证列加密密钥。放独立文件（权限 600，属主 coding2api），
# 不要写在本 unit 里，否则 systemctl cat 会把密钥暴露给任何用户。
# 启动前校验：权限靠人工 chmod 时遗忘过高（644）就是全员可读的密钥。
# %% 是 systemd 的字面 %，写成 %a 会被当成未定义说明符。
ExecStartPre=/bin/sh -c 'test "$(stat -c %%a /opt/coding2api/.env)" = "600" || { echo ".env 权限必须是 600" >&2; exit 1; }'
EnvironmentFile=/opt/coding2api/.env
Environment=HOST=127.0.0.1
Environment=PORT=8000
Environment=DATA_DIR=/opt/coding2api/data

ExecStart=/opt/coding2api/.venv/bin/python -m src.main
# always 而不是 on-failure：**干净退出也要被拉起**（进程不在了却没人重启，
# 等于服务静默消失）。与 launchd 侧 KeepAlive 的取向一致。
# 「另一实例已持锁」时应用刻意以 0 退出（src/main.py 的 AlreadyRunning 分支），
# always 会反复重拉——由 [Unit] 的 StartLimit*（5 分钟 5 次）封顶，进入 failed
# 状态停下等人介入，而不是每 5s 无限重试、把日志刷满。
Restart=always
RestartSec=5

# SIGTERM 后在途请求排空窗口：必须 >= src/main.py GRACEFUL_SHUTDOWN_SECONDS(90)，
# 否则 systemd 会在排空完成前 SIGKILL，长流请求被硬断、统计落不下来。
TimeoutStopSec=95

# 日志交给 journald（自带轮转）
StandardOutput=journal
StandardError=journal

# umask 0077：日志（journald 之外的任何落盘文件）、备份、导出的凭证文件
# 默认 022 会落成 0644，同机其它用户可读。数据目录里已有 0600/0700 的显式
# 收紧，这里再兜一层，覆盖应用没显式设权限的新文件。
UMask=0077

# 只需要写 data/ 与读 secrets/
NoNewPrivileges=true
PrivateTmp=true
# 不访问任何物理/虚拟设备节点（/dev/null、/dev/urandom 等由 systemd 按需
# 提供，不受影响）。应用不碰摄像头、块设备、GPU。
PrivateDevices=true
# 只允许 TCP/UDP/Unix socket：挡掉 raw socket 与 netlink 等非常规族
# （SSRF 到链路层、或借 AF_PACKET 嗅探同机流量）。IPv6 也要留，否则
# 上游只有 AAAA 记录时连不上。
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# 内存上限是保守默认：正常 RSS 约 150–400MB，大库/高并发时按需上调。
# 超限由内核 OOM kill 进程，再由 Restart=always 拉起。
MemoryMax=1G
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/coding2api/data
ReadOnlyPaths=/opt/coding2api/secrets

[Install]
WantedBy=multi-user.target
