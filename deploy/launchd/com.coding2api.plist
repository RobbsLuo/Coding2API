<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 模板：绝对路径写成 __PROJECT_ROOT__ 占位符，避免把开发机的路径带进仓库。
     安装时用 scripts/install-launchd.sh 渲染成本机路径，写入
     ~/Library/LaunchAgents/com.coding2api.plist 并加载。
     launchd 不展开 $HOME / 环境变量，路径必须是绝对路径，所以只能安装时替换。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.coding2api</string>

    <!-- 入口是 wrapper 而不是直接 uvicorn：启动前先构建前端产物
         （后端在 http://127.0.0.1:8000/ 直接服务 web/dist，见
         src/webapp/static.py）。构建失败不阻断启动的取舍见
         scripts/launchd-server.sh 顶部说明。 -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_ROOT__/scripts/launchd-server.sh</string>
    </array>

    <!-- .env 用相对路径读取，必须切到项目根 -->
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <!-- 登录时自动启动 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 进程退出/崩溃后自动拉起。
         SuccessfulExit=false 意为「**只在非零退出时**重拉」：真崩溃照样救回来，
         但「另一个实例已在使用该 DATA_DIR」（退出码 2）不再每 10s 重拉一次。
         此前用 KeepAlive=true 无条件重拉，端口被占时实测刷出 2377 条
         `[Errno 48] address already in use`（2026-09-19~10-17），每条都堆着
         完整 traceback，把真正的故障挤出了视野。 -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <!-- SIGTERM → SIGKILL 的等待窗口。launchd 默认约 20s，短于应用侧的
         排空窗口（src/main.py GRACEFUL_SHUTDOWN_SECONDS=90），长流请求会被
         硬断、统计落不下来。这里给 95s（= 排空窗口 + 5s 余量），与
         docker-compose 的 stop_grace_period、systemd 的 TimeoutStopSec 同口径。
         tests/deploy/test_assets.py 锁定三处 >= 应用侧窗口。 -->
    <key>ExitTimeOut</key>
    <integer>95</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/launchd.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- PATH 只有系统目录：本机 pnpm 装在 nvm 下，由
             scripts/build-web.sh 自行解析后追加，不在这里写死。 -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
